    "bin/",
    "server/",
    "start.sh",
    "README.md",
    "LICENSE",
    "!server/config.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/gamebanana-mods-downloader.js",
    "prepublishOnly": "node scripts/prepublish-guard.js",
    "verify:pack": "bash scripts/verify-pack.sh"
  },
  "author": "EIGHTfs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EIGHTfs/gamebanana-mods-downloader.git"
  },
  "homepage": "https://github.com/EIGHTfs/gamebanana-mods-downloader#readme",
  "bugs": {
    "url": "https://github.com/EIGHTfs/gamebanana-mods-downloader/issues"
  },
  "keywords": [
    "gamebanana",
    "mod",
    "downloader",
    "nas",
    "self-hosted"
  ]
}

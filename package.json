{
  "name": "gamebanana-mods-downloader",
  "version": "1.0.0",
  "description": "在浏览器里浏览与下载 GameBanana 上的 mod：本地索引、任务队列、断点续传，零 npm 依赖",
  "bin": {
    "gamebanana-mods-downloader": "bin/gamebanana-mods-downloader.js"
  },
